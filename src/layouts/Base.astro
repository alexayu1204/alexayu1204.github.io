---
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).href;
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Haoting (Alexa) Yu',
  alternateName: 'Alexa Yu',
  jobTitle: 'Creative Computing Researcher',
  url: 'https://alexayu1204.github.io/',
  email: 'mailto:alexy1204@yahoo.com',
  knowsAbout: ['Multimodal generative AI', 'Music information retrieval',
    'Automatic drum transcription', 'Retrieval-augmented generation',
    'Authorship in AI art', 'Creative computing', 'Mathematics', 'Operational research'],
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'University of British Columbia' },
    { '@type': 'CollegeOrUniversity', name: 'University of Edinburgh' },
    { '@type': 'CollegeOrUniversity', name: 'University of the Arts London' },
  ],
  sameAs: ['https://github.com/alexayu1204', 'https://www.linkedin.com/in/alexa-yu'],
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={url} />
  <meta name="theme-color" content="#1a1016" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={url} />
  <meta property="og:image" content={new URL('/og.jpg', Astro.site).href} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:site_name" content="Haoting (Alexa) Yu" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={new URL('/og.jpg', Astro.site).href} />
  <set:html value={`<script type="application/ld+json">${JSON.stringify(person)}</script>`} />
  <slot name="head" />
</head>
<body>
  <slot />
</body>
</html>
