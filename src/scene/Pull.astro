---
/**
 * The cord. Twisted rope, an oval brass ring, a fluted finial.
 * The rope path and the finial transform are both driven from `pull.ts` every frame —
 * these are just the resting shapes.
 */
---
<g id="pull-group">
  <defs>
    <linearGradient id="ropeG" gradientUnits="userSpaceOnUse" x1="145" y1="0" x2="155" y2="0">
      <stop offset="0" stop-color="#3b2b22"/>
      <stop offset=".4" stop-color="#7c6142"/>
      <stop offset=".62" stop-color="#9c7c55"/>
      <stop offset="1" stop-color="#33251d"/>
    </linearGradient>
    <linearGradient id="finialG" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#5c4119"/>
      <stop offset=".3" stop-color="#c39d55"/>
      <stop offset=".5" stop-color="#f0d69a"/>
      <stop offset=".72" stop-color="#a87d38"/>
      <stop offset="1" stop-color="#503818"/>
    </linearGradient>
    <linearGradient id="glintG" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffe6b0" stop-opacity="0"/>
      <stop offset=".5" stop-color="#ffe6b0" stop-opacity=".9"/>
      <stop offset="1" stop-color="#ffe6b0" stop-opacity="0"/>
    </linearGradient>
  </defs>

  <!-- the cord itself; `d` is rewritten each frame -->
  <path id="pull-rope" d="M150 -6 Q150 260 150 470" fill="none"
        stroke="url(#ropeG)" stroke-width="9" stroke-linecap="round"/>
  <path id="pull-rope-twist" d="M150 -6 Q150 260 150 470" fill="none"
        stroke="#e0c69c" stroke-width="3" stroke-linecap="round"
        stroke-dasharray="5 10" opacity=".45"/>

  <!-- the highlight that travels the cord unprompted after a while -->
  <g id="pull-glint" style="opacity:0">
    <rect x="144" y="0" width="12" height="90" fill="url(#glintG)"
          style="transform: translateY(calc(var(--glint, 0) * 420px))"/>
  </g>

  <g id="pull-bob">
   <g transform="scale(0.92)">
    <!-- ring -->
    <ellipse cx="0" cy="10" rx="12" ry="16" fill="none" stroke="url(#finialG)" stroke-width="4.5"/>
    <ellipse cx="0" cy="10" rx="12" ry="16" fill="none" stroke="#f6e2b4" stroke-width="1.1" opacity=".45"/>
    <!-- collar -->
    <path d="M-9 26 H9 L7 33 H-7Z" fill="url(#finialG)"/>
    <!-- fluted body -->
    <path d="M-11 33 C-13 48 -11 62 -6 72 L6 72 C11 62 13 48 11 33Z" fill="url(#finialG)"/>
    <path d="M-5 34 C-6 48 -5 60 -3 71" stroke="#5c4119" stroke-width="1.1" fill="none" opacity=".55"/>
    <path d="M2 34 C3 48 2 60 1 71" stroke="#5c4119" stroke-width="1.1" fill="none" opacity=".55"/>
    <path d="M-8 34 C-9 48 -8 60 -6 71" stroke="#f6e2b4" stroke-width=".9" fill="none" opacity=".35"/>
    <!-- base knop -->
    <ellipse cx="0" cy="74" rx="8" ry="4" fill="url(#finialG)"/>
    <path d="M0 78 C3 84 3 90 0 94 C-3 90 -3 84 0 78Z" fill="url(#finialG)"/>
   </g>
  </g>
</g>
