---
import Section from '../../layouts/Section.astro';
import { getCollection } from 'astro:content';
import art from '../../data/art.json';

const all = (await getCollection('artwork')).sort((a, b) => a.data.order - b.data.order);
const pick = (role: string) => all.filter((a) => a.data.role === role);
const install = pick('install')[0];
const pages = pick('page');
const documentation = pick('documentation')[0];
const other = pick('work');
const f = art.feature;
---
<Section
  wide title="ART" kicker="Studio & installation"
  lede="The making that runs alongside the research."
  description="Artwork by Haoting (Alexa) Yu: the Inbox Archive installation, Chinese ink-and-brush painting, and mixed-media work."
>
  <article class="work">
    <h2 class="work__title">{f.title}</h2>

    {install && (
      <figure class="plate plate--wide">
        <img src={install.data.image} alt={install.data.alt} loading="eager" decoding="async" />
      </figure>
    )}

    <p class="work__meta">{f.medium} &middot; {f.dimensions} &middot; {f.year}</p>
    <p class="work__credit">{f.exhibition}</p>
    <p class="work__statement">{f.statement}</p>

    {/* hung as they were hung: five A4 pages in a row, 2018 on the left */}
    <ol class="strip">
      {pages.map((p) => (
        <li class="strip__item">
          <figure class="plate">
            <img src={p.data.thumb} alt={p.data.alt} loading="lazy" decoding="async" />
          </figure>
          <p class="strip__year">{p.data.year}</p>
        </li>
      ))}
    </ol>

    {documentation && (
      <figure class="plate plate--doc">
        <img src={documentation.data.thumb} alt={documentation.data.alt} loading="lazy" decoding="async" />
      </figure>
    )}
  </article>

  <section class="work">
    <h2 class="work__title">{art.otherWork.heading}</h2>
    <p class="work__statement">{art.otherWork.intro}</p>
    <div class="gallery gallery--four">
      {other.map((w) => (
        <figure class="plate">
          <img src={w.data.thumb} alt={w.data.alt} loading="lazy" decoding="async" />
        </figure>
      ))}
    </div>
  </section>
</Section>
