---
import Section from '../../layouts/Section.astro';
import { getCollection, render } from 'astro:content';
const pubs = (await getCollection('publications')).sort((a, b) => a.data.order - b.data.order);
const bodies = await Promise.all(pubs.map((p) => render(p)));
---
<Section
  title="publication" kicker="Papers & enquiry"
  lede="Creative Computing, Human-AI Co-Creation, Multimodal Generative AI"
  description="Publications by Haoting (Alexa) Yu: creative MRAG control and governance, and curatorial agency in AI art."
>
  {pubs.map((p, i) => {
    const Body = bodies[i].Content;
    return (
      <article class="entry">
        <h2 class="entry__title">{p.data.title}</h2>
        <div class="entry__body"><Body /></div>
      </article>
    );
  })}
</Section>
