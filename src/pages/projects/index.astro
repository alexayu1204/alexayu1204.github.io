---
import Section from '../../layouts/Section.astro';
import { getCollection, render } from 'astro:content';
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const bodies = await Promise.all(projects.map((p) => render(p)));
---
<Section
  wide title="Projects" kicker="Selected work"
  lede="Interactive, technical and creative-coding work — courtrooms staged by language models, constellations built from survey text, neural networks hung as pictures."
  description="Projects by Haoting (Alexa) Yu: multi-agent LLM systems, generative models, computer vision, optimisation and creative computing."
>
  {projects.map((p, i) => {
    const Body = bodies[i].Content;
    return (
      <article class="entry">
        <h2 class="entry__title">{p.data.title}</h2>
        {(p.data.period || p.data.tags.length > 0) && (
          <p class="entry__meta">
            {p.data.period && <span>{p.data.period}</span>}
            {p.data.tags.map((t) => <span class="pill">{t}</span>)}
          </p>
        )}
        <div class="entry__body"><Body /></div>
        {p.data.links.length > 0 && (
          <p class="link-row">
            {p.data.links.map((l) => (
              <a class="link" href={l.href} target="_blank" rel="noopener noreferrer">{l.label} &rarr;</a>
            ))}
          </p>
        )}
      </article>
    );
  })}
</Section>
