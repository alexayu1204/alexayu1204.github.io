---
import Section from '../../layouts/Section.astro';
import site from '../../data/site.json';
---
<Section
  title="contact" kicker="A lit window"
  description="Contact Haoting (Alexa) Yu — email, phone and location."
>
  <ul class="contact-list">
    <li><span class="contact-key">Email</span><a class="link" href={`mailto:${site.email}`}>{site.email}</a></li>
    <li><span class="contact-key">Phone</span><a class="link" href={site.phoneHref}>{site.phone}</a></li>
    <li><span class="contact-key">Based in</span><span>{site.location}</span></li>
    <li><span class="contact-key">CV</span><a class="link" href={site.cvFile} download>Resume.pdf</a></li>
  </ul>
</Section>
