---
import Section from '../../layouts/Section.astro';
import { getCollection } from 'astro:content';
const photos = (await getCollection('photography')).sort((a, b) => a.data.order - b.data.order);
---
<Section
  wide title="photography" kicker="Light, held still"
  description="Photography by Haoting (Alexa) Yu."
>
  <div class="prints">
    {photos.map((p, i) => (
      <figure class="print">
        <img
          src={p.data.image}
          alt={p.data.alt}
          loading={i === 0 ? 'eager' : 'lazy'}
          decoding="async"
        />
      </figure>
    ))}
  </div>
</Section>
